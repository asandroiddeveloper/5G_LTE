    <string name="permission_title">Show my 5G / 4G type</string>
    <string name="permission_body">Android keeps the current network type hidden from apps until you grant the Phone permission. It is read on-device only — nothing is stored or sent anywhere.</string>
    <string name="permission_button">Allow</string>

    <!-- Setup screen -->
    <string name="setup_heading">Set your preferred network mode</string>
    <string name="setup_intro">Android does not let an app change radio settings for you, so this screen opens the hidden menu and you pick the mode yourself. It takes about 20 seconds.</string>
    <string name="setup_step_1">Tap “Open Phone info”.</string>
    <string name="setup_step_2">Find “Set Preferred Network Type”.</string>
    <string name="setup_step_3">Choose the option from the Guide tab, then come back here.</string>
    <string name="setup_open_button">Open Phone info</string>
    <string name="setup_device_hint">Detected %1$s. Usual path: %2$s</string>
    <string name="setup_open_failed_title">Couldn\'t open the hidden menu</string>
    <string name="setup_open_failed_body">Your device does not expose the Phone info screen to apps. Dial %1$s in the dialer to open it manually.</string>
    <string name="setup_copy_code">Copy code</string>
    <string name="setup_copied">Copied to clipboard</string>
    <string name="setup_dial_fallback">Open dialer</string>
    <string name="setup_close">Close</string>
    <string name="warning_title">⚠️ Network mode warning</string>
    <string name="warning_body_1">Choosing “LTE only” or “NR only” can block calls and SMS when your carrier does not support VoLTE/VoNR in your area.</string>
    <string name="warning_body_2">For reliable calling keep the automatic mode (LTE/GSM/WCDMA auto, sometimes shown with “PRL”) so the phone can fall back to 3G or 2G for voice.</string>
    <string name="warning_body_3">Only lock to 4G or 5G if your carrier supports voice over that network and your coverage is strong.</string>
    <string name="warning_footer">Warning signs of a bad mode: missed calls, calls that drop instantly, or “no service” after a reboot.</string>

