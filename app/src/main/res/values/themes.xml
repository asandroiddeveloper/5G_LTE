<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Single application theme. The app is dark by design, so there is no
         DayNight variant: the gradient UI is the brand. windowBackground matches
         the gradient's darkest colour so there is no white flash on cold start. -->
    <style name="Theme.JetPackUI" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme handled by androidx.core:core-splashscreen, which gives one
         seamless splash on every API level instead of a second custom activity. -->
    <style name="Theme.JetPackUI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.JetPackUI</item>
    </style>

</resources>
