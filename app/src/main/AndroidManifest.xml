<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permission: lets the app read the active network's capabilities.
         No runtime prompt is shown for this one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional runtime permission. The app is fully usable without it; it is only
         needed to display the current network type (5G / 4G / 3G). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Package visibility (Android 11+): the app probes these packages to find the
         hidden "Phone info" screen. -->
    <queries>
        <package android:name="com.android.phone" />
        <package android:name="com.android.settings" />
        <package android:name="com.samsung.android.app.telephonyui" />
        <package android:name="com.mediatek.settings" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JetPackUI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JetPackUI.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".qstile.RadioInfoTile"
            android:exported="true"
            android:icon="@drawable/ic_qs_radio"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
